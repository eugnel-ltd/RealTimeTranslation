{
  "name": "rtt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run legal:build && npm --prefix client run build && npm run verify:bundle",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "dev:client": "npm --prefix client run dev",
    "dev:worker": "wrangler dev",
    "types": "wrangler types --env-interface WorkerEnv --include-runtime false",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "replay": "node scripts/replay-transcript.mjs",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "release": "python3 -B scripts/web-release.py",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && npm --prefix client run typecheck",
    "lint": "npm --prefix client run lint",
    "legal:build": "node scripts/generate-legal.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.45.3",
    "yaml": "2.8.3"
  },
  "dependencies": {
    "eugnel-platform": "github:eugnel-ltd/eugnel-platform#1c50ea103198dd274156d7c3a8a807e5bddddd99",
    "jose": "^6.1.0"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "overrides": {
    "yaml": "2.8.3"
  }
}
