{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtt",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  // 5s CPU leaves headroom for Gemini Live WebSocket message forwarding; I/O wait is excluded.
  // At most 2 provider fetches (translation fallback or detector retry); answer adds 1 KV read.
  // 50 subrequests leaves wide room for Access JWKS, KV operations and redirects;
  // a request that loops on fetch still stops there.
  "limits": { "cpu_ms": 5000, "subrequests": 50 },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "rtt.eugnel.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "6001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      // Shared 120/min per caller: ~30 utterance translations + up to 60 detector checks,
      // leaving 30 for per-question answers, extraction and occasional token/session renewals.
      "name": "PAID_API_RATE_LIMIT",
      "namespace_id": "6002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PROFILES",
      // The live PROFILES namespace of the rtt Worker (17 Oct 2026). A new account: see DEPLOY.md.
      "id": "5b213bbe04c14fb287ce53076fd90ddc"
    }
  ],
  "vars": {
    "AZURE_SPEECH_REGION": "uksouth",
    "AZURE_TRANSLATOR_REGION": "",
    "ACCESS_TEAM_DOMAIN": "https://eugnel.cloudflareaccess.com",
    "SKIP_ACCESS_CHECK": "false",
    "DEFAULT_ANSWER_MODEL": "claude-opus-5-5",
    "GEMINI_TRANSLATE_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_LIVE_TRANSCRIBE_MODEL": "gemini-3.5-transcribe-live",
    "GEMINI_LIVE_TRANSLATE_MODEL": "gemini-3.5-live-translate-preview",
    "TYPESAFE_MODEL": "jev-latest"
  }
}
