{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "baseUrl": "..",
    "paths": {
      "react": ["client/node_modules/@types/react"],
      "react/*": ["client/node_modules/@types/react/*"],
      "react-dom/*": ["client/node_modules/@types/react-dom/*"]
    }
  },
  "include": ["**/*.ts", "../client/src/vite-env.d.ts", "../vitest.config.ts"]
}
